{
  "manifest_version": 3,
  "name": "Discord Direct Links",
  "version": "0.1.1",
  "description": "Skip Discord web's confirmation for ordinary external links. Leaves download controls alone.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "content_scripts": [{
    "matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}
